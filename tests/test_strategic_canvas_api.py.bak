    @pytest.mark.asyncio
    @patch('backend.dependencies.get_current_user_id')
    async def test_delete_element_success(self, mock_get_user, test_client, sample_canvas_create_data, sample_element_create_data):
        """Test successful element deletion"""
        mock_user_id = uuid4()
        mock_get_user.return_value = mock_user_id
        
        # Create canvas and element
        canvas_response = await test_client.post("/api/subjective/canvas", json=sample_canvas_create_data)
        canvas_id = canvas_response.json()["id"]
        
        element_response = await test_client.post(
            f"/api/subjective/canvas/{canvas_id}/elements",
            json=sample_element_create_data
        )
        element_id = element_response.json()["id"]
        
        # Delete element
        delete_response = await test_client.delete(
            f"/api/subjective/canvas/{canvas_id}/elements/{element_id}"
        )
        
        assert delete_response.status_code == status.HTTP_204_NO_CONTENT
        
        # Verify element is gone by checking canvas
        canvas_check = await test_client.get(f"/api/subjective/canvas/{canvas_id}")
        canvas_data = canvas_check.json()
        assert len(canvas_data["elements"]) == 0
    
