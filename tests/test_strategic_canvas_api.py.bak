        assert element_data["element_type"] == sample_element_create_data["element_type"]
        assert element_data["content"] == sample_element_create_data["content"]
        assert element_data["position"] == sample_element_create_data["position"]
        assert "id" in element_data
        assert "created_at" in element_data
