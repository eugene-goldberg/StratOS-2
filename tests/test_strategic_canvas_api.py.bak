class TestCanvasAPIIntegration:
    """Integration tests for complete canvas workflows"""
    
    @pytest.mark.asyncio
    @patch('backend.dependencies.get_current_user_id')
    async def test_complete_canvas_workflow(self, mock_get_user, test_client):
        """Test complete workflow: create canvas -> add elements -> update -> delete"""
        mock_user_id = uuid4()
        mock_get_user.return_value = mock_user_id
        
        # 1. Create canvas
        canvas_data = {
            "title": "Integration Test Canvas",
            "description": "Testing complete workflow"
        }
        canvas_response = await test_client.post("/api/subjective/canvas", json=canvas_data)
        assert canvas_response.status_code == status.HTTP_201_CREATED
        canvas_id = canvas_response.json()["id"]
        
        # 2. Add multiple elements
        elements = []
        for i in range(3):
            element_data = {
                "element_type": f"node_{i}",
                "content": {"text": f"Element {i}"},
                "position": {"x": i * 100, "y": i * 100}
            }
            element_response = await test_client.post(
                f"/api/subjective/canvas/{canvas_id}/elements",
                json=element_data
            )
            assert element_response.status_code == status.HTTP_201_CREATED
            elements.append(element_response.json())
        
        # 3. Verify canvas has all elements
        canvas_check = await test_client.get(f"/api/subjective/canvas/{canvas_id}")
        canvas_full = canvas_check.json()
        assert len(canvas_full["elements"]) == 3
        
        # 4. Update an element
        element_to_update = elements[1]["id"]
        update_data = {"content": {"text": "Updated Element 1", "status": "modified"}}
        
        update_response = await test_client.put(
            f"/api/subjective/canvas/{canvas_id}/elements/{element_to_update}",
            json=update_data
        )
        assert update_response.status_code == status.HTTP_200_OK
        
        # 5. Delete an element
        element_to_delete = elements[2]["id"]
        delete_response = await test_client.delete(
            f"/api/subjective/canvas/{canvas_id}/elements/{element_to_delete}"
        )
        assert delete_response.status_code == status.HTTP_204_NO_CONTENT
        
        # 6. Final verification
        final_canvas = await test_client.get(f"/api/subjective/canvas/{canvas_id}")
        final_data = final_canvas.json()
        assert len(final_data["elements"]) == 2  # One deleted
        
        # Check updated element
        updated_element = next(
            el for el in final_data["elements"] 
            if el["id"] == element_to_update
        )
        assert updated_element["content"]["text"] == "Updated Element 1"
        assert updated_element["content"]["status"] == "modified"
    
    @pytest.mark.asyncio
    @patch('backend.dependencies.get_current_user_id')
    async def test_user_isolation_via_api(self, mock_get_user, test_client):
        """Test that users cannot access each other's canvases via API"""
        # Create canvas for user 1
        user1_id = uuid4()
        mock_get_user.return_value = user1_id
        
        canvas_data = {"title": "User 1 Canvas", "description": "Private canvas"}
        user1_canvas_response = await test_client.post("/api/subjective/canvas", json=canvas_data)
        assert user1_canvas_response.status_code == status.HTTP_201_CREATED
        user1_canvas_id = user1_canvas_response.json()["id"]
        
        # Switch to user 2
        user2_id = uuid4()
        mock_get_user.return_value = user2_id
        
        # User 2 should not be able to access User 1's canvas
        access_response = await test_client.get(f"/api/subjective/canvas/{user1_canvas_id}")
        assert access_response.status_code == status.HTTP_404_NOT_FOUND
        
        # User 2 should not see User 1's canvas in their list
        list_response = await test_client.get("/api/subjective/canvas")
        assert list_response.status_code == status.HTTP_200_OK
        user2_canvases = list_response.json()
        user2_canvas_ids = [canvas["id"] for canvas in user2_canvases]
        assert user1_canvas_id not in user2_canvas_ids
    
    @pytest.mark.asyncio
    @patch('backend.dependencies.get_current_user_id')
    async def test_element_connections_via_api(self, mock_get_user, test_client):
        """Test creating connected elements via API"""
        mock_user_id = uuid4()
        mock_get_user.return_value = mock_user_id
        
        # Create canvas
        canvas_data = {"title": "Connected Elements Test"}
        canvas_response = await test_client.post("/api/subjective/canvas", json=canvas_data)
        canvas_id = canvas_response.json()["id"]
        
        # Create first element
        element1_data = {
            "element_type": "source_node",
            "content": {"text": "Source Node"},
            "position": {"x": 100, "y": 100}
        }
        element1_response = await test_client.post(
            f"/api/subjective/canvas/{canvas_id}/elements",
            json=element1_data
        )
        element1_id = element1_response.json()["id"]
        
        # Create second element connected to first
        element2_data = {
            "element_type": "target_node",
            "content": {"text": "Target Node"},
            "position": {"x": 300, "y": 100},
            "connections": [element1_id]
        }
        element2_response = await test_client.post(
            f"/api/subjective/canvas/{canvas_id}/elements",
            json=element2_data
        )
        assert element2_response.status_code == status.HTTP_201_CREATED
        
        # Verify connection
        canvas_check = await test_client.get(f"/api/subjective/canvas/{canvas_id}")
        canvas_data = canvas_check.json()
        
        connected_element = next(
            el for el in canvas_data["elements"] 
            if el["element_type"] == "target_node"
        )
        assert element1_id in connected_element["connections"]


class TestCanvasAPIErrorHandling:
    """Test suite for API error handling and edge cases"""
    
    @pytest.mark.asyncio
    @patch('backend.dependencies.get_current_user_id')
    async def test_invalid_json_payloads(self, mock_get_user, test_client):
        """Test API handling of invalid JSON payloads"""
        mock_user_id = uuid4()
        mock_get_user.return_value = mock_user_id
        
        # Test with malformed JSON
        response = await test_client.post(
            "/api/subjective/canvas",
            content="invalid json content",
            headers={"Content-Type": "application/json"}
        )
        
        assert response.status_code == status.HTTP_422_UNPROCESSABLE_ENTITY
    
    @pytest.mark.asyncio
    @patch('backend.dependencies.get_current_user_id')
    async def test_oversized_payloads(self, mock_get_user, test_client):
        """Test API handling of very large payloads"""
        mock_user_id = uuid4()
        mock_get_user.return_value = mock_user_id
        
        # Create very large content
        large_content = {"data": "x" * 100000}  # 100KB of data
        
        canvas_data = {
            "title": "Large Content Test",
            "description": "Testing large content handling"
        }
        canvas_response = await test_client.post("/api/subjective/canvas", json=canvas_data)
        canvas_id = canvas_response.json()["id"]
        
        element_data = {
            "element_type": "large_element",
            "content": large_content,
            "position": {"x": 0, "y": 0}
        }
        
        # Should handle large content gracefully
        response = await test_client.post(
            f"/api/subjective/canvas/{canvas_id}/elements",
            json=element_data
        )
        
        # May succeed or fail with appropriate error, but shouldn't crash
        assert response.status_code in [
            status.HTTP_201_CREATED,
            status.HTTP_413_REQUEST_ENTITY_TOO_LARGE,
            status.HTTP_422_UNPROCESSABLE_ENTITY
        ]