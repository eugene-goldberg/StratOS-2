    @pytest.mark.asyncio
    @patch('backend.dependencies.get_current_user_id')
    async def test_list_canvases_empty(self, mock_get_user, test_client):
        """Test listing canvases when none exist"""
        mock_user_id = uuid4()
        mock_get_user.return_value = mock_user_id
        
        response = await test_client.get("/api/subjective/canvas")
        
        assert response.status_code == status.HTTP_200_OK
        data = response.json()
        assert isinstance(data, list)
        assert len(data) == 0
    
    @pytest.mark.asyncio
    @patch('backend.dependencies.get_current_user_id')
    async def test_list_canvases_with_data(self, mock_get_user, test_client):
        """Test listing canvases with existing data"""
        mock_user_id = uuid4()
        mock_get_user.return_value = mock_user_id
        
        # Create multiple canvases
        canvas_titles = ["Canvas 1", "Canvas 2", "Canvas 3"]
        created_canvases = []
        
        for title in canvas_titles:
            canvas_data = {"title": title, "description": f"Description for {title}"}
            response = await test_client.post("/api/subjective/canvas", json=canvas_data)
            assert response.status_code == status.HTTP_201_CREATED
            created_canvases.append(response.json())
        
        # List canvases
        list_response = await test_client.get("/api/subjective/canvas")
        
        assert list_response.status_code == status.HTTP_200_OK
        canvases = list_response.json()
        assert len(canvases) == 3
        
        # Check that all created canvases are in the list
        canvas_ids = {canvas["id"] for canvas in canvases}
        created_ids = {canvas["id"] for canvas in created_canvases}
        assert canvas_ids == created_ids
    
    @pytest.mark.asyncio
    @patch('backend.dependencies.get_current_user_id')
    async def test_list_canvases_pagination(self, mock_get_user, test_client):
        """Test canvas listing with pagination parameters"""
        mock_user_id = uuid4()
        mock_get_user.return_value = mock_user_id
        
        # Create 5 canvases
        for i in range(5):
            canvas_data = {"title": f"Canvas {i}", "description": f"Description {i}"}
            response = await test_client.post("/api/subjective/canvas", json=canvas_data)
            assert response.status_code == status.HTTP_201_CREATED
        
        # Test pagination
        response = await test_client.get("/api/subjective/canvas?limit=2&offset=0")
        assert response.status_code == status.HTTP_200_OK
        page1 = response.json()
        assert len(page1) == 2
        
        response = await test_client.get("/api/subjective/canvas?limit=2&offset=2")
        assert response.status_code == status.HTTP_200_OK
        page2 = response.json()
        assert len(page2) == 2
        
        response = await test_client.get("/api/subjective/canvas?limit=2&offset=4")
        assert response.status_code == status.HTTP_200_OK
        page3 = response.json()
        assert len(page3) == 1


class TestCanvasElementAPI:
    """Test suite for Canvas Element API endpoints"""
    
    @pytest.mark.asyncio
