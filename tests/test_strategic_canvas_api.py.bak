class TestStrategicCanvasAPI:
    """Test suite for Strategic Canvas API endpoints"""
    
    @patch('backend.dependencies.get_current_user_id')
    def test_create_canvas_success(self, mock_get_user, test_client, sample_canvas_create_data):
        """Test successful canvas creation"""
        mock_user_id = uuid4()
        mock_get_user.return_value = mock_user_id
        
        response = await test_client.post(
            "/api/subjective/canvas",
            json=sample_canvas_create_data
        )
        
        assert response.status_code == status.HTTP_201_CREATED
        
        data = response.json()
        assert data["title"] == sample_canvas_create_data["title"]
        assert data["description"] == sample_canvas_create_data["description"]
        assert "id" in data
        assert data["user_id"] == str(mock_user_id)
        assert "created_at" in data
        assert "updated_at" in data
        assert data["elements"] == []
    
    @pytest.mark.asyncio
    @patch('backend.dependencies.get_current_user_id')
    async def test_create_canvas_missing_title(self, mock_get_user, test_client):
        """Test canvas creation with missing title"""
        mock_user_id = uuid4()
        mock_get_user.return_value = mock_user_id
        
        invalid_data = {
            "description": "Canvas without title"
            # Missing required 'title' field
        }
        
        response = await test_client.post(
            "/api/subjective/canvas",
            json=invalid_data
        )
        
        assert response.status_code == status.HTTP_422_UNPROCESSABLE_ENTITY
        error_detail = response.json()
        assert "title" in str(error_detail)
    
    @pytest.mark.asyncio
    @patch('backend.dependencies.get_current_user_id')
    async def test_create_canvas_empty_title(self, mock_get_user, test_client):
        """Test canvas creation with empty title"""
        mock_user_id = uuid4()
        mock_get_user.return_value = mock_user_id
        
        data = {
            "title": "",
            "description": "Canvas with empty title"
        }
        
        response = await test_client.post(
            "/api/subjective/canvas",
            json=data
        )
        
        # Should succeed - empty string is valid
        assert response.status_code == status.HTTP_201_CREATED
        response_data = response.json()
        assert response_data["title"] == ""
    
    @pytest.mark.asyncio
    async def test_create_canvas_unauthorized(self, test_client, sample_canvas_create_data):
        """Test canvas creation without authentication"""
        response = await test_client.post(
            "/api/subjective/canvas",
            json=sample_canvas_create_data
        )
        
        # Should fail due to missing authentication
        assert response.status_code in [status.HTTP_401_UNAUTHORIZED, status.HTTP_403_FORBIDDEN]
    
    @pytest.mark.asyncio
    @patch('backend.dependencies.get_current_user_id')
    async def test_get_canvas_success(self, mock_get_user, test_client, sample_canvas_create_data):
        """Test successful canvas retrieval"""
        mock_user_id = uuid4()
        mock_get_user.return_value = mock_user_id
        
        # First create a canvas
        create_response = await test_client.post(
            "/api/subjective/canvas",
            json=sample_canvas_create_data
        )
        assert create_response.status_code == status.HTTP_201_CREATED
        canvas_data = create_response.json()
        canvas_id = canvas_data["id"]
        
        # Then retrieve it
        get_response = await test_client.get(f"/api/subjective/canvas/{canvas_id}")
        
