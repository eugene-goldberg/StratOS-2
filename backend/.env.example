# Azure OpenAI Service configuration
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-instance.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name

# Azure Speech Service configuration
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=your-azure-speech-region

# Azure Cosmos DB configuration
AZURE_COSMOS_ENDPOINT=https://your-cosmos-db-account.documents.azure.com:443/
AZURE_COSMOS_KEY=your-cosmos-db-key
AZURE_COSMOS_DATABASE=stratos

# Azure Search configuration
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your-search-api-key
AZURE_SEARCH_INDEX_NAME=stratos-index