# StratOS Multi-Agent System Environment Variables
# Copy this file to .env and fill in your values

# Application Settings
APP_NAME="StratOS Multi-Agent System"
ENVIRONMENT=development  # development, staging, production
PORT=8000
DEBUG=true

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Azure AI Foundry Settings
AI_FOUNDRY_ENDPOINT=https://your-ai-foundry.cognitiveservices.azure.com
AI_FOUNDRY_PROJECT_ID=your-project-id
AI_FOUNDRY_API_KEY=your-api-key  # Only for development

# Azure OpenAI Settings
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com
AZURE_OPENAI_API_KEY=your-openai-key  # Only for development
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Model Deployment Names
GPT4_DEPLOYMENT_NAME=gpt-4
GPT4O_DEPLOYMENT_NAME=gpt-4o
GPT35_DEPLOYMENT_NAME=gpt-35-turbo
O_SERIES_DEPLOYMENT_NAME=o1
EMBEDDING_DEPLOYMENT_NAME=text-embedding-ada-002

# Cosmos DB Settings (Standard Agent Setup)
COSMOS_ENDPOINT=https://your-cosmos.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key  # Only for development
COSMOS_DATABASE_NAME=stratos_agents

# Azure AI Search Settings
SEARCH_ENDPOINT=https://your-search.search.windows.net
SEARCH_API_KEY=your-search-key  # Only for development

# Authentication Settings (MSAL)
AZURE_CLIENT_ID=your-app-client-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_SECRET=your-client-secret  # Only for development

# Service Bus Settings (optional)
SERVICE_BUS_CONNECTION_STRING=your-connection-string
SERVICE_BUS_NAMESPACE=your-namespace

# Application Insights (optional)
APPINSIGHTS_CONNECTION_STRING=your-connection-string
APPINSIGHTS_INSTRUMENTATION_KEY=your-key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json